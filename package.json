{
  "name": "vcpdeck",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "node scripts/test.cjs",
    "dev": "pnpm --filter @vcpdeck/shared --filter @vcpdeck/sdk build && pnpm --parallel --filter @vcpdeck/shared --filter @vcpdeck/frontend --filter @vcpdeck/server dev",
    "dev:all": "pnpm --filter @vcpdeck/shared --filter @vcpdeck/sdk build && pnpm --parallel --filter @vcpdeck/shared --filter @vcpdeck/frontend --filter @vcpdeck/server --filter @vcpdeck/client dev",
    "lint": "pnpm -r lint",
    "download:frp": "npx tsx scripts/download-frp.ts",
    "test:frp": "node scripts/test-frp.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
