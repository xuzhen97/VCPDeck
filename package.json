{
  "name": "vcpdeck",
  "version": "0.21.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "exports": {
    ".": "./dsh/index.mjs",
    "./dsh": "./dsh/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh/index.mjs",
    "dsh/cordis.patch.yml",
    "skills/vcpdeck/SKILL.md",
    "skills/vcpdeck/vcpdeck.cjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "node scripts/tests/e2e/test.cjs",
    "test:scripts": "node --test scripts/tests/unit/*.test.cjs && tsx --test scripts/tests/unit/*.test.ts",
    "dev": "pnpm --filter @vcpdeck/shared --filter @vcpdeck/sdk build && pnpm --parallel --filter @vcpdeck/shared --filter @vcpdeck/frontend --filter @vcpdeck/server dev",
    "dev:all": "pnpm --filter @vcpdeck/shared --filter @vcpdeck/sdk build && pnpm --parallel --filter @vcpdeck/shared --filter @vcpdeck/frontend --filter @vcpdeck/server --filter @vcpdeck/client dev",
    "lint": "npx --yes @biomejs/biome@^2 lint packages scripts",
    "release": "npx tsx scripts/build/pack-release.ts",
    "download:frp": "npx tsx scripts/build/download-frp.ts",
    "test:frp": "node scripts/tests/manual/test-frp.cjs",
    "test:cli": "node scripts/tests/e2e/test-cli-capabilities.cjs",
    "test:vcp-plugin": "node scripts/tests/e2e/test-vcp-plugin.cjs",
    "test:dsh": "node --test dsh/index.test.mjs",
    "vcpdeck:link": "node scripts/dev/link-cli.cjs"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.1.1",
    "archiver": "^8.0.0",
    "esbuild": "^0.24.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
