generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
}

model Client {
  id                String    @id
  name              String?   @unique // 别名：默认取 hostname（重名自动加后缀），服务端可修改；迁移前旧记录为 null，注册时自愈补齐
  hostname          String
  os                String
  cpuModel          String
  totalMemMB        Int
  clientVersion     String
  capabilities      String    @default("[]")
  capabilityDetails String    @default("{}")
  disks             String    @default("[]")
  online            Boolean   @default(false)
  lastHeartbeatAt   DateTime?
  cpuPercent        Float?
  memPercent        Float?
  runningJobs       String    @default("[]")
  connectedAt       DateTime?
  socketId          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  jobs              Job[]
  frpMappings       FrpMapping[]
  terminalSessions  TerminalSession[]
}

model Job {
  id           String    @id
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  type         String    @default("exec")
  status       String    @default("pending")
  payload      String    @default("{}")
  result       String?
  progress     String?
  errorCode    String?
  errorMessage String?
  timeout      Int?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  createdByIdentityId String?
  createdByName       String?
  createdVia          String?
  updatedAt    DateTime  @updatedAt
}

model Release {
  id           String   @id
  version      String   @unique
  archives     String   @default("{}") // 平台 -> { sha256, size, fileName }（JSON）
  status       String   @default("uploaded") // uploaded | updating_server | updating_clients | done | failed
  clientStates String   @default("{}")        // clientId -> { state, reason?, at }（JSON，审计用）
  errorMessage String?
  createdByName String? // 上传者（由 AuthGuard 注入）
  createdVia   String?  // 上传来源（web/cli）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ClientInstallerConfig {
  id                  String   @id
  enabled             Boolean  @default(false)
  updatedByIdentityId String?
  updatedByName       String?
  updatedVia          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ── P2P 隧道 ICE/coturn 配置（只存非秘密字段；shared secret 走 VCPDECK_TURN_SECRET_FILE） ──
model TunnelConfig {
  id        String   @id
  stunUrls  String   @default("[]") // JSON 数组：stun/stuns URL
  turnUrls  String   @default("[]") // JSON 数组：turn/turns URL
  realm     String   @default("")
  updatedAt DateTime @updatedAt
}

model ReleaseUploadSession {
  id                  String   @id
  version             String
  platform            String
  sha256              String
  size                Int
  provider            String
  providerKey         String
  providerUploadId    String
  partSize            Int
  status              String   @default("pending") // pending | provider_completed | completed
  createdByIdentityId String?
  createdByName       String?
  createdVia          String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([version, platform])
  @@index([expiresAt])
}

model Identity {
  id           String         @id
  username     String         @unique
  displayName  String
  passwordHash String
  isAdmin      Boolean        @default(false)
  disabledAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  credentials  Credential[]
  sessions     AuthSession[]
}

model Credential {
  id         String    @id
  identityId String
  identity   Identity  @relation(fields: [identityId], references: [id])
  label      String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model AuthSession {
  id          String    @id
  identityId  String
  identity    Identity  @relation(fields: [identityId], references: [id])
  sessionHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model FrpMapping {
  id           String   @id
  clientId     String
  client       Client       @relation(fields: [clientId], references: [id])
  frpsInstanceId String?
  frpsInstance   FrpsInstance? @relation(fields: [frpsInstanceId], references: [id])
  name         String
  proxyType    String   @default("tcp")
  localIp      String   @default("127.0.0.1")
  localPort    Int
  remotePort   Int?
  customDomain String?
  status       String   @default("inactive")
  publicUrl    String?
  operationJobId String?
  operationTimeoutSeconds Int @default(30)
  errorCode    String?
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([frpsInstanceId, name])
}

model FrpsInstance {
  id                String   @id                          // "frps_" + uuid8
  name              String                                // 实例名称
  serverAddr        String                                // frps 连接地址
  serverPort        Int      @default(7000)
  authToken         String   @default("")
  dashboardScheme   String   @default("http")             // "http" | "https"
  dashboardHost     String?
  dashboardPort     Int      @default(7500)
  dashboardUser     String   @default("admin")
  dashboardPassword String   @default("admin")
  portRangeStart    Int      @default(20000)
  portRangeEnd      Int      @default(21000)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  mappings          FrpMapping[]
}

model StorageBackendConfig {
  id        Int      @id @default(autoincrement())
  kind      String   @default("local")
  config    String   @default("{}")
  updatedAt DateTime @updatedAt
}

model File {
  id          String    @id
  key         String    @unique
  jobId       String?
  clientId    String
  filename    String
  mimeType    String?
  size        Int
  sha256      String
  status      String    @default("pending")
  storageKind String    @default("local")
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  purpose     String    @default("job")
  shares      StorageShare[]
}

model StorageShare {
  id                    String    @id
  tokenHash             String    @unique
  fileId                String?
  file                  File?     @relation(fields: [fileId], references: [id], onDelete: SetNull)
  filename              String
  mimeType              String?
  storageKind           String
  createdByIdentityId   String?
  createdByName         String?
  createdVia            String?
  createdAt             DateTime  @default(now())
  revokedAt             DateTime?
  revokedByIdentityId   String?
  invalidatedAt         DateTime?
  invalidReason         String?

  @@index([fileId])
}

// ── 交互式终端会话（只存元数据；终端正文/快照/token 不入库） ──
model TerminalSession {
  id                  String   @id
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id])
  shellId             String
  shellLabel          String
  status              String   @default("starting")
  cols                Int
  rows                Int
  createdByIdentityId String?
  createdByName       String?
  createdAt           DateTime @default(now())
  lastAttachedAt      DateTime?
  detachedAt          DateTime?
  expiresAt           DateTime?
  endedAt             DateTime?
  endReason           String?
  errorCode           String?
  updatedAt           DateTime @updatedAt

  audits TerminalAuditEvent[]

  @@index([clientId, createdAt])
  @@index([clientId, status])
}

// ── 终端最小审计（只记录生命周期事件，不记录输入输出） ──
model TerminalAuditEvent {
  id         String   @id
  sessionId  String
  session    TerminalSession @relation(fields: [sessionId], references: [id])
  clientId   String
  event      String
  identityId String?
  actorName  String?
  source     String?
  result     String   @default("ok")
  reason     String?
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([sessionId, createdAt])
}

// ── 远程 Pi 集中配置（Plan 1：Profile / Credential / Binding） ──
// 权威边界见 docs/design/remote-pi-control-plane.md §6 与 ADR-0029：
// Profile/Credential/Binding 只由 Server 持久化，Client 不落盘；
// Credential 只存密文与安全元数据，明文不得进入普通 API、日志或审计。
model PiProfile {
  id                   String   @id
  name                 String   @unique
  enabled              Boolean  @default(true)
  defaultProvider      String
  defaultModelId       String
  allowedModels        String   @default("[]") // JSON: [{ provider, modelId, maxThinkingLevel? }]
  defaultThinkingLevel String   @default("medium")
  // JSON: [resourceId]；NULL = 未配置（无 Bundle 资源需求）
  enabledResourceIds   String?
  // JSON: { allow, confirm, deny }；NULL = 未配置（等价空策略，未列出工具全部拒绝）
  toolPolicyJson       String?
  revision             Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  credentials PiProfileCredential[]
  bindings    PiClientBinding[]
}

model PiProvider {
  id                String   @id
  name              String   @unique
  runtimeProviderId String   @unique
  protocol          String?
  baseUrl           String?
  headers           String   @default("{}")
  enabled           Boolean  @default(true)
  revision          Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  models      PiProviderModel[]
  credentials PiCredential[]
}

model PiProviderModel {
  id         String   @id
  providerId String
  modelId    String
  name       String
  /// NULL = 元数据由 Client 侧 Pi 内置目录解析；非 NULL = 显式元数据 JSON。
  metadata   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider PiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelId])
  @@index([providerId])
}



model PiCredential {
  id               String      @id
  name             String      @unique
  provider         String
  providerConfigId String
  providerConfig   PiProvider  @relation(fields: [providerConfigId], references: [id])
  ciphertext       String // base64(iv || tag || ciphertext)
  keyVersion       Int         @default(1)
  fingerprint      String // sha256(明文) hex，仅用于人工比对
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  lastUsedAt       DateTime?
  revokedAt        DateTime?

  profiles PiProfileCredential[]

  @@index([provider])
  @@index([providerConfigId])
}

model PiProfileCredential {
  profileId    String
  credentialId String
  profile      PiProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  credential   PiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@id([profileId, credentialId])
}

model PiClientBinding {
  clientId  String   @id
  profileId String
  profile   PiProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@index([profileId])
}
