# VCPDeck Server 配置
# 复制此文件为 .env 并按需修改

# 身份认证
VCPDECK_ADMIN_USERNAME=admin
VCPDECK_ADMIN_PASSWORD=test123
VCPDECK_FRONTEND_ORIGIN=http://localhost:5173
VCPDECK_SESSION_TTL_SECONDS=604800
VCPDECK_COOKIE_SECURE=false

# 远程客户端 PSK
VCPDECK_CLIENT_PSK=vcpdeck-dev-psk

# 数据库
DATABASE_URL="file:./prisma/dev.db"

# Pi Provider 凭据根密钥（文件内容为 base64 的 32 字节）；未设则凭据写入 fail closed，
# 保存 Provider 会返回 PI_CONFIG_UNAVAILABLE。密钥文件放在仓库外，勿提交：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" > ~/.vcpdeck/pi-credential.key
# VCPDECK_PI_CREDENTIAL_KEY_FILE=
