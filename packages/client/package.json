{
  "name": "@vcpdeck/client",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "prebuild": "node ../../scripts/ensure-frpc.cjs",
    "start": "node dist/index.js",
    "dev": "npx tsx ../../scripts/build-dev-pi-bundle.ts && node ../../scripts/ensure-dev-app-layout.cjs && pnpm build && node ../../scripts/wait-for-server.cjs && node ../../scripts/dev-client.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@vcpdeck/shared": "workspace:*",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "node-datachannel": "0.33.4",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "vitest": "^3.2.7"
  }
}
