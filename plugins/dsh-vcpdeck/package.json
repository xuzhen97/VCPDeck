{
	"name": "@vcpdeck/dsh-panel",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "在 DSH 中查看 VCPDeck 机器，并一键打开目标机的远程 DSH WebUI（ADR-0059）",
	"exports": {
		".": "./index.js",
		"./client": "./client.js",
		"./locale/*.json": "./locale/*.json",
		"./icon": "./icon.svg"
	},
	"files": [
		"index.js",
		"client.js",
		"cordis.patch.yml",
		"locale/*.json",
		"icon.svg",
		"README.md"
	],
	"dsh": {
		"bundle": { "patch": "./cordis.patch.yml" },
		"client": {
			"platform": "web",
			"immediately": true,
			"inject": [
				"@deepseek-ai/dsh-client-ui-sidebar",
				"@deepseek-ai/dsh-client-ui-layout"
			]
		}
	}
}
