# VCPDeck Server 地址 (例如 http://127.0.0.1:3000 或 https://deck.yourdomain.com)
SERVER_URL=http://127.0.0.1:3000

# VCPDeck API Token (从驾驶台 /settings/tokens 页面生成的 Bearer Token)
API_TOKEN=vcpdeck_tok_your_api_token_here

# (可选) 公开分享基地址；为空时回退 SERVER_URL，仅支持 HTTP(S)
PUBLIC_SHARE_BASE_URL=

# (可选) 请求超时时间 (毫秒)，默认 30000
REQUEST_TIMEOUT_MS=30000
