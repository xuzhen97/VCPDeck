# ── 身份认证 ──
VCPDECK_ADMIN_USERNAME=admin
VCPDECK_ADMIN_PASSWORD=test123
VCPDECK_FRONTEND_ORIGIN=http://localhost:5173
VCPDECK_SESSION_TTL_SECONDS=604800
VCPDECK_COOKIE_SECURE=false

# ── Server 监听 ──
# 默认 3001；改端口时需同步 Client VCPDECK_SERVER 与 Server Launcher VCPDECK_PROBE_URL
VCPDECK_PORT=3001

# ── 远程客户端 PSK ──
VCPDECK_CLIENT_PSK=vcpdeck-dev-psk
VCPDECK_CLIENT_PSK_FILE=

# ── 数据库 ──
DATABASE_URL=file:./prisma/dev.db

# ── Pi Provider 凭据根密钥（未设则 Pi 凭据写入 fail closed）──
# 本地 dev 无需手工配置：`pnpm dev` / `pnpm dev:all` 会先在 .tmp/dev-secrets/ 自动生成密钥，
# 并把变量写进 packages/server/.env（已有密钥一律复用、不覆盖）。生产请显式提供进程外密钥文件：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" > ~/.vcpdeck/pi-credential.key
# VCPDECK_PI_CREDENTIAL_KEY_FILE=
